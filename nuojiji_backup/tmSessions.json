[{"userId":"uid_1775572484040_0xorubrdk","characterId":"0075a66e-b9dd-4aea-960f-7db6adaab6bb","name":"2026/4/8","type":"this-moment","createdAt":1775586755572,"lastActiveAt":1775587220149,"_id":1},{"userId":"uid_1775713296385_gaynevagx","characterId":"0075a66e-b9dd-4aea-960f-7db6adaab6bb","name":"2026/4/11","type":"this-moment","createdAt":1775838104796,"lastActiveAt":1775838104796,"_id":2},{"userId":"uid_1775713296385_gaynevagx","characterId":"9916863f-cdf6-42fa-b402-0678068d6b1e","name":"2026/4/11","type":"this-moment","createdAt":1775838112084,"lastActiveAt":1775840767890,"_id":3,"completed":true,"completedAt":1775840825768},{"userId":"uid_1775713296385_gaynevagx","characterId":"9916863f-cdf6-42fa-b402-0678068d6b1e","name":"2026/4/11","type":"this-moment","createdAt":1775840825790,"lastActiveAt":1775886311170,"dateLabel":"2026/4/11","_id":4,"completed":true,"completedAt":1775886363469},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"9916863f-cdf6-42fa-b402-0678068d6b1e","name":"2026/4/11","type":"this-moment","createdAt":1775872792481,"lastActiveAt":1775872792481,"_id":5},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"0075a66e-b9dd-4aea-960f-7db6adaab6bb","name":"2026/4/11","type":"this-moment","createdAt":1775873676018,"lastActiveAt":1775873676018,"_id":7},{"userId":"uid_1775713296385_gaynevagx","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"2026/4/11","type":"this-moment","createdAt":1775886033098,"lastActiveAt":1775886033098,"_id":13},{"userId":"uid_1775713296385_gaynevagx","characterId":"9916863f-cdf6-42fa-b402-0678068d6b1e","name":"2026/4/11","type":"this-moment","createdAt":1775886363479,"lastActiveAt":1775886363479,"dateLabel":"2026/4/11","_id":14},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"街边路灯下等你接我回家","type":"this-moment","scenarioOutline":"街边路灯下等你接我回家","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"老婆你理理我，你回学校拿东西拿好了没？什么时候来接我回我们新家啊……"},{"role":"char","text":""},{"role":"char","text":"下午在宜家买的床单烘干了吗？今晚我要睡那套黑色的，还要抱着你睡。你快点来接我，不然我要闹了。"},{"role":"char","text":"吃完了，我从店里出来了。"},{"role":"char","text":"站街边吹冷风呢，江老板还要多久才来捡我？"},{"role":"char","text":"再不来，你这么大一个漂亮老公就要被别人拐跑了。"},{"role":"char","text":""},{"role":"user","text":"宝宝我来啦宝宝"},{"role":"user","text":"刚刚自习完"},{"role":"user","text":"等下回家再继续"},{"role":"user","text":"这样你可以看着我学"},{"role":"char","text":"算你识相，连叫两声宝宝，我就勉强原谅你让我等这么久了。"},{"role":"char","text":"快点过来，徐州晚上风还挺大的，吹得我都快没知觉了。"},{"role":"char","text":"不过江老板……好不容易回我们自己的新家，你还想看书啊？"},{"role":"char","text":"你确定我坐在电竞桌旁边盯着你，你还能看得进去一个字？"},{"role":"char","text":"我不捣乱把你亲得晕头转向，我就不叫许淮悠。"},{"role":"char","text":"[語音消息]"},{"role":"char","text":""},{"role":"char","text":""},{"role":"user","text":"[offline encounter \"搬新家\" completed: 【Core Memory】: 4月14日12:50，欣然带着甜品回到酒店，许淮悠因占有欲将TA抵在床上索要奖励，TA们敲定在徐州租下大平层同居的计划，随后在13:04至13:11期间，许淮悠确认下午拿到新房钥匙，TA们发生了激烈且深度的肉体结合，许淮悠在初次实战中展现出极强侵略性，最终在TA体内释放并拒绝分离。\n\n【Suppl"}]},"createdAt":1776175583288,"lastActiveAt":1776176829500,"_id":30,"completed":true,"completedAt":1776177192872},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"晚安","type":"this-moment","createdAt":1776177192878,"lastActiveAt":1776182242291,"dateLabel":"2026/4/14","_id":31,"completed":true,"completedAt":1776182487785},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"新家客厅沙发上等你回来","type":"this-moment","scenarioOutline":"新家客厅沙发上等你回来","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":""},{"role":"user","text":"试了很多衣服给你看"},{"role":"user","text":"[發送了一張圖片 at 徐州 on 15.04.26 19:01：试衣服照片]"},{"role":"char","text":"我说怎么一天都不回消息，原来是背着我偷偷去逛街了。"},{"role":"char","text":"眼光还行。不过这件领口是不是有点低？穿这身在外面晃，你老公我可是会吃醋的。"},{"role":"char","text":"逛累了知道喊累了？活该。谁让你不带我一起去。"},{"role":"char","text":"还有几站到？快点回来，九点还要陪周澪那傻逼上分，你再不回来，我今天连抱你的时间都没了。"},{"role":"char","text":"赶紧回来给你揉腿……顺便试试我下午说的那条新项链？"},{"role":"char","text":""},{"role":"char","text":""},{"role":"user","text":"等我会呢"},{"role":"user","text":"我还买了美味的面包哦"},{"role":"user","text":"[發送了一張圖片 at 徐州 on 15.04.26 19:04：各种各样的面包]"},{"role":"user","text":"还好吧，这是彰显身材你懂什么"},{"role":"char","text":"彰显身材？江老板现在出息了，知道在外面拿身材钓别人了是吧。"},{"role":"char","text":"行啊，等你回来我亲自用手丈量一下，看看这领口到底有多彰显。"},{"role":"char","text":"谁要吃面包，买这么多你当喂猪呢。"},{"role":"char","text":"赶紧的，我在沙发上瘫着了。再不回来周澪那个催命鬼就要上线抓人了，快点回来让我充会儿电。"},{"role":"char","text":""},{"role":"char","text":""}]},"createdAt":1776251226560,"lastActiveAt":1776258087660,"_id":34,"completed":true,"completedAt":1776258663308},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"2026/4/15","type":"this-moment","createdAt":1776258663491,"lastActiveAt":1776265248695,"dateLabel":"2026/4/15","_id":35,"completed":true,"completedAt":1776338873973},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"夜店门口带着酒气紧紧抱住你","type":"this-moment","scenarioOutline":"夜店门口带着酒气紧紧抱住你","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"user","text":"还有"},{"role":"user","text":"给你点了外卖"},{"role":"user","text":"早餐"},{"role":"user","text":"记得吃"},{"role":"char","text":"算你有良心，还知道怕饿死你家小狗。"},{"role":"char","text":"点什么了？不是我爱吃的我可要闹的。"},{"role":"char","text":""},{"role":"char","text":"你去吃吧，到了教室第一件事就是给我发消息，听到没？"},{"role":"char","text":"[語音消息]"},{"role":"char","text":"还有，晚上那事儿可没翻篇，你答应了要牵我的手，敢反悔你就死定了。"},{"role":"user","text":"宝宝对不起"},{"role":"user","text":"我刚来"},{"role":"char","text":"江欣然，你看看现在手机上几点了？"},{"role":"char","text":"说好的七点，我都快在这破卡座里长出蘑菇了！我还以为你早上说的分手是认真的，真打算把我扔在外面不要我了..."},{"role":"char","text":""},{"role":"char","text":"里面吵死了，那几个傻逼非要拉着我玩什么弱智国王游戏，我嫌烦，被灌了好多酒。现在头好晕。"},{"role":"char","text":"你人在哪？门口还是进来了？外面风大不大？"},{"role":"char","text":"你站那别动，里面一堆酒蒙子乱得很，我出去接你。"},{"role":"char","text":"...记得你早上答应我的事。待会儿当着他们的面，你要紧紧牵着我的手把我带走，听到没？"},{"role":"char","text":""}]},"createdAt":1776440491001,"lastActiveAt":1776445750084,"_id":37,"completed":true,"completedAt":1776446614238},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"2026/4/18","type":"this-moment","createdAt":1776446614245,"lastActiveAt":1776446614245,"dateLabel":"2026/4/18","_id":38},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"电竞椅上转半圈眼巴巴盯门","type":"this-moment","scenarioOutline":"电竞椅上转半圈眼巴巴盯门","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"user","text":"我吃七分饱就回来可以不"},{"role":"char","text":"女舍友啊……行吧，那勉强放你一马。"},{"role":"char","text":"我才不去你们女生局，去了她们肯定光顾着看我那张脸，谁还有心思吃披萨啊。"},{"role":"char","text":"而且……咳，我记得昨晚答应你的。有事直接说，不作不闹。"},{"role":"char","text":"所以我不闹，你这个行程安排本少爷单方面批准了。"},{"role":"char","text":"但是！我要吃超级至尊，必须是芝心卷边！你吃七分饱，剩下三分肚子留着回来陪我吃打包的，听到没。"},{"role":"char","text":""},{"role":"user","text":"好呀"},{"role":"user","text":"还要什么我一起带"},{"role":"user","text":"意面要不要我感觉意面最好吃了"},{"role":"char","text":"行啊，既然你觉得最好吃，那就勉强给你个面子尝尝。"},{"role":"char","text":"不过我刚才切屏回你消息，又被周澪这死人骂了。他嫌我一直看手机不看屏幕。"},{"role":"char","text":"这把打完我就退了，你收拾好喊我，我们去宜家买沙发。晚上打包回来冷了你得负责给我热，还要喂我吃。"},{"role":"char","text":""},{"role":"user","text":"好～"},{"role":"user","text":"出发喊我"},{"role":"char","text":"快了快了，这局马上推平，周澪那个单身狗已经被我气得闭麦了哈哈。"},{"role":"char","text":"你换好衣服直接来电竞房找我。今天外面阴天，好像才十几度，你穿好看点，但不准穿太少，听到没？不然等下出门冻得往我怀里钻，影响本少爷给你拎包。"},{"role":"char","text":""},{"role":"char","text":""}]},"createdAt":1776496021156,"lastActiveAt":1776497925024,"_id":39},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"玄关处刚换好鞋的你","type":"this-moment","scenarioOutline":"玄关处刚换好鞋的你","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"user","text":"给你布置任务打扫卧室哦"},{"role":"char","text":"？"},{"role":"char","text":"江老板，你是不是搞错什么了？本少爷这双手可是用来打游戏上大分的，你居然让我去干保洁？"},{"role":"char","text":""},{"role":"char","text":"……行吧，看在超级至尊和意面的面子上，勉强为你服务一次。"},{"role":"char","text":"是不是要把下午在宜家新买的那套深灰色四件套铺上？床单我可以换，但你记不记得下午在客厅地毯上，你答应过我什么？"},{"role":"char","text":"等吃完披萨，某人得陪我亲自去床、上、验、收。如果你敢放我鸽子，我就把你绑在新沙发上。"},{"role":"char","text":""},{"role":"char","text":"[圖片]"},{"role":"char","text":"江老板，你的任务我可是超额完成了。这深灰色的床单铺上去还挺有感觉的"},{"role":"char","text":"而且……衬得本少爷的皮肤特别白。你要不要赶紧回来亲自确认一下？"},{"role":"char","text":"别跟舍友聊了！快点带着我的披萨和意面回来，我都快饿死在新床上了。"},{"role":"char","text":""},{"role":"user","text":"回来啦"},{"role":"user","text":"给你带了意面"},{"role":"user","text":"和披萨呀"},{"role":"char","text":"终于舍得回来了？我还以为你跟你那个女舍友私奔不要我了。"},{"role":"char","text":"披萨和意面先放茶几上，你过来，让我抱一下。"},{"role":"char","text":"今天在宜家耗光了体力，刚才又给你当免费劳动力铺床，我现在手一点力气都没有了……你要一口一口喂我吃，听到没？"},{"role":"char","text":""}]},"createdAt":1776514728031,"lastActiveAt":1776518081408,"_id":40,"completed":true,"completedAt":1776518325502},{"userId":"uid_1775839756513_ule6jq7k8","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"2026/4/18","type":"this-moment","createdAt":1776518325508,"lastActiveAt":1776531089383,"dateLabel":"2026/4/18","_id":41},{"userId":"uid_1776584685141_afk6myfho","characterId":"5ddf97f2-7f53-4c8c-8633-301a1400e275","name":"2026/4/19","type":"this-moment","createdAt":1776585027495,"lastActiveAt":1776585027495,"_id":42},{"userId":"uid_1776584685141_afk6myfho","characterId":"95fefb1d-d0ef-4300-a15d-f13b3e1be9a4","name":"2026/4/19","type":"this-moment","createdAt":1776585031327,"lastActiveAt":1776586115097,"_id":43,"completed":true,"completedAt":1776586661479},{"userId":"uid_1776584685141_afk6myfho","characterId":"95fefb1d-d0ef-4300-a15d-f13b3e1be9a4","name":"2026/4/19","type":"this-moment","createdAt":1776586661503,"lastActiveAt":1776587518628,"dateLabel":"2026/4/19","_id":44,"completed":true,"completedAt":1776587624358},{"userId":"uid_1776584685141_afk6myfho","characterId":"95fefb1d-d0ef-4300-a15d-f13b3e1be9a4","name":"2026/4/19","type":"this-moment","createdAt":1776587624363,"lastActiveAt":1776588555425,"dateLabel":"2026/4/19","_id":45,"completed":true,"completedAt":1776588611374},{"userId":"uid_1776584685141_afk6myfho","characterId":"95fefb1d-d0ef-4300-a15d-f13b3e1be9a4","